      "en": {
        "short": "Keep",
        "title": "What goes in Git, what stays out",
        "body": [
          "Keep code, prompts, eval cases and config in Git.",
          "Keep API keys, .env files and model weights out. For large files use Git LFS, an object store or a model hub."
