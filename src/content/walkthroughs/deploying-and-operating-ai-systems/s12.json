  "steps": [
    {
      "en": {
        "short": "Shift left",
        "title": "Find problems when a change is made",
        "body": [
          "DevSecOps puts security checks into the same pipeline as the tests.",
          "The idea is to find a security problem when a change is made, not after it ships."
        ]
      },
      "bn": {
        "short": "আগেই চেক",
        "title": "পরিবর্তনের সময়ই সমস্যা ধরুন",
        "body": [
          "DevSecOps নিরাপত্তার চেক টেস্টের একই পাইপলাইনে রাখে।",
          "ধারণাটা হলো নিরাপত্তার সমস্যা পরিবর্তনের সময়ই ধরা, ডিপ্লয়ের পরে নয়।"
        ]
      },
      "show": [
        {
          "id": "ci",
          "state": "hot",
          "sub": {
            "en": "next to the tests",
            "bn": "টেস্টের পাশেই"
          }
        },
        {
          "id": "svc",
          "state": "dim",
          "sub": {
            "en": "after it ships",
            "bn": "ডিপ্লয়ের পরে"
          }
        }
      ],
      "links": [
        {
          "from": "ci",
          "to": "svc",
          "flow": "to",
          "state": "dim"
        }
      ],
      "values": [
        {
          "en": "in CI",
          "bn": "CI-তে"
        },
        null,
        null,
        null
      ]
    },
    {
      "en": {
        "short": "Secrets",
        "title": "Keys stay out of Git and images",
        "body": [
          "Keep API keys and passwords in a secrets manager, and inject them when the service starts.",
          "Never in Git, never in an image."
        ],
        "note": {
          "kind": "warn",
          "html": "A Kubernetes Secret is only base64-encoded unless you turn on encryption at rest, so limit who can read it."
        }
      },
      "bn": {
        "short": "সিক্রেট",
        "title": "key থাকে Git আর ইমেজের বাইরে",
        "body": [
          "API key আর পাসওয়ার্ড রাখুন সিক্রেট ম্যানেজারে, আর সার্ভিস চালুর সময় সেগুলো দিন।",
          "কখনো Git-এ নয়, কখনো ইমেজে নয়।"
        ],
        "note": {
          "kind": "warn",
          "html": "এনক্রিপশন অ্যাট রেস্ট চালু না করলে Kubernetes Secret শুধু base64-এনকোড করা থাকে, তাই কে পড়তে পারে তা সীমিত করুন।"
        }
      },
      "show": [
        {
          "id": "vault",
          "state": "hot"
        },
        {
          "id": "svc",
          "state": "hot",
          "sub": {
            "en": "gets them at start",
            "bn": "চালুর সময় পায়"
          }
        },
        {
          "id": "git",
          "state": "warn",
          "sub": {
            "en": "never",
            "bn": "কখনো নয়"
          }
        }
      ],
      "links": [
        {
          "from": "vault",
